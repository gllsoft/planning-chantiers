{
  "name": "planning-chantiers",
  "productName": "Planning Chantiers",
  "version": "1.0.0",
  "description": "Planning des chantiers (Gantt) avec base de données locale",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "author": "Planning Chantiers",
  "scripts": {
    "start": "electron .",
    "dist": "node build/build.js",
    "dist:universal": "node build/build.js --universal",
    "test": "node test/run.js"
  },
  "build": {
    "appId": "fr.planning-chantiers.app",
    "productName": "Planning Chantiers",
    "copyright": "© 2026",
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "updater.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "identity": null,
      "artifactName": "planning-chantiers-${version}-${arch}.${ext}"
    },
    "dmg": {
      "title": "Planning Chantiers ${version}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Planning Chantiers",
      "uninstallDisplayName": "Planning Chantiers",
      "artifactName": "planning-chantiers-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "synopsis": "Planning des chantiers (Gantt)",
      "artifactName": "planning-chantiers-${version}-${arch}.${ext}"
    },
    "afterPack": "build/adhoc-sign.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gllsoft/planning-chantiers.git"
  }
}
